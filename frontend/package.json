{
  "name": "stock-manager-frontend",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/health.test.ts tests/client.test.ts tests/pending.test.ts",
    "build": "npm run typecheck && vite build",
    "test:live": "node --experimental-strip-types tests/health.live.ts"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.1"
  }
}
